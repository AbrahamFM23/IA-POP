
<Window x:Class="AI_Pop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64"
        Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <Border x:Name="BubbleBorder"
                Width="64"
                Height="64"
                CornerRadius="32"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                MouseLeftButtonDown="BubbleBorder_MouseLeftButtonDown">

            <TextBlock x:Name="BubbleIcon"
                       Text="◉"
                       Foreground="White"
                       FontSize="36"
                       FontWeight="Normal"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>

        </Border>
    </Grid>

</Window>
